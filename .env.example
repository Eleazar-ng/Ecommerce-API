# Server
NODE_ENV=
PORT=

# Database
MONGO_URI=mongodb://localhost:27017/

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:

# Google Sign-In
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Super admin seeder (only used when running `npm run seed:super-admin`)
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change-this-before-seeding
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Resend (transactional email)
RESEND_API_KEY=re_your_api_key
# Must be a verified sending domain in your Resend account, or their shared test address
# (works without domain verification, but only delivers to your own Resend account email):
RESEND_FROM_EMAIL="Your App <onboarding@resend.dev>"